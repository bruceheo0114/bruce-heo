{"kind":"card","start":35.0,"end":37.0}],
"captions":[
{"start":0,"end":3.0,"text":"AI 답은 늘 5~7점짜리라고 불평했어요"},
{"start":3.0,"end":6.2,"text":"그런데 AI 탓이 아니었어요"},
{"start":6.42,"end":8.0,"text":"회의에서 반박당하기 싫어서"},
{"start":8.0,"end":11.9,"text":"아이디어를 AI에게 몇 번씩 검증받고 있었거든요"},
{"start":12.02,"end":15.1,"text":"파격적인 아이디어는 원래 반박당하기 쉬워요"},
{"start":15.22,"end":18.7,"text":"그래서 AI를 거칠수록 뾰족한 부분이 깎여요"},
{"start":18.86,"end":20.1,"text":"AI가 뭉뚝한 게 아니라"},
{"start":20.16,"end":22.7,"text":"제가 뭉뚝해지고 있었던 거죠"},
{"start":22.82,"end":24.5,"text":"그래서 순서를 바꿔요"},
{"start":24.64,"end":26.3,"text":"날것의 생각을 먼저 펼치고"},
{"start":26.36,"end":28.7,"text":"AI에겐 그다음에 물어요"},
{"start":28.92,"end":31.4,"text":"여러분은 AI에게 먼저 묻나요?"},
{"start":31.46,"end":32.6,"text":"먼저 써 보나요?"},
{"start":32.76,"end":35.0,"text":"다음 제안서 쓰기 전에 저장해 두세요"}]}
