 "captions": [
  {
   "start": 0,
   "end": 3.0,
   "text": "간단한 디자인은 이제 챗GPT에 맡긴대요"
  },
  {
   "start": 3.1,
   "end": 6.6,
   "text": "그럼 10년 차 마케터의 일도 넘길 수 있을까요?"
  },
  {
   "start": 6.9,
   "end": 9.4,
   "text": "저도 인플루언서 섭외를 맡겨 봤어요"
  },
  {
   "start": 9.56,
   "end": 12.1,
   "text": "팔로워 수, 참여율은 금방 정리해 줬죠"
  },
  {
   "start": 12.26,
   "end": 15.9,
   "text": "그런데 이 캠페인에 맞는 사람인지는 못 골랐어요"
  },
  {
   "start": 16.12,
   "end": 19.5,
   "text": "브랜드가 예민하게 보는 이미지, 호흡이 맞던 느낌"
  },
  {
   "start": 19.6,
   "end": 22.8,
   "text": "그 기준을 말로 꺼내 본 적이 없었거든요"
  },
  {
   "start": 23.02,
   "end": 26.3,
   "text": "AI가 못한 게 아니라, 제가 설명을 못 한 거예요"
  },
  {
   "start": 26.58,
   "end": 28.4,
   "text": "신입에게 인수인계하듯"
  },
  {
   "start": 28.4,
   "end": 31.0,
   "text": "일하는 순서와 판단 기준부터 적어 보세요"
  },
  {
   "start": 31.25,
   "end": 34.3,
   "text": "여러분의 판단 기준, 한 문장으로 말할 수 있나요?"
  },
  {
   "start": 34.4,
   "end": 37.6,
   "text": "AI 자동화에서 막힌 동료에게 보내 주세요"
  }
