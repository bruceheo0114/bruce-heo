# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# 영상 요약 에이전트 (비우면 OPENAI_MODEL을 그대로 씁니다)
OPENAI_VIDEO_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# LinkedIn personal member post and comment APIs
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID
LINKEDIN_API_VERSION=202605

# Optional dry-run: validates the next LinkedIn payload without publishing
SOCIAL_DRY_RUN=false
